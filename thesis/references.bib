@article{makridakis2025,
  title = {The {{M6}} Forecasting Competition: {{Bridging}} the Gap between Forecasting and Investment Decisions},
  shorttitle = {The {{M6}} Forecasting Competition},
  author = {Makridakis, Spyros and Spiliotis, Evangelos and Hollyman, Ross and Petropoulos, Fotios and Swanson, Norman and Gaba, Anil},
  date = {2025-10-01},
  journaltitle = {International Journal of Forecasting},
  shortjournal = {International Journal of Forecasting},
  volume = {41},
  number = {4},
  pages = {1315--1354},
  issn = {0169-2070},
  doi = {10.1016/j.ijforecast.2024.11.002},
  url = {https://www.sciencedirect.com/science/article/pii/S0169207024001079},
  urldate = {2026-09-29},
  abstract = {The M6 forecasting competition, the sixth in the Makridakis competition sequence, focused on financial forecasting. A key objective of the M6 competition was to contribute to the debate surrounding the Efficient Market Hypothesis by examining how and why market participants make investment decisions. To address these objectives, the M6 competition investigated forecasting accuracy and investment performance in a universe of 100 publicly traded assets. The competition employed live evaluation on real data across multiple periods, a cross-sectional setting where participants predicted asset performance relative to that of other assets, and a direct evaluation of the utility of forecasts. In this way, we were able to measure the benefits of accurate forecasting and assess the importance of forecasting when making investment decisions. Our findings highlight the challenges that participants faced when attempting to accurately forecast the relative performance of assets, the great difficulty associated with trying to consistently outperform the market, the limited connection between submitted forecasts and investment decisions, the value added by information exchange and the “wisdom of crowds”, and the value of utilizing risk models when attempting to connect prediction and investing decisions.},
  keywords = {Assets,Forecast accuracy,Forecasting competitions,Investment decisions,M competitions},
  file = {/Users/marcgrayson/Zotero/storage/KTM9ECBU/Makridakis et al. - 2025 - The M6 forecasting competition Bridging the gap between forecasting and investment decisions.pdf;/Users/marcgrayson/Zotero/storage/DM34AYDQ/S0169207024001079.html}
}

@online{stanek2024,
  title = {M6 {{Investment Challenge}}: {{The Role}} of {{Luck}} and {{Strategic Considerations}}},
  shorttitle = {M6 {{Investment Challenge}}},
  author = {Staněk, Filip},
  date = {2024-11-21},
  eprint = {2412.04490},
  eprinttype = {arXiv},
  eprintclass = {q-fin.PM},
  doi = {10.48550/arXiv.2412.04490},
  url = {http://arxiv.org/abs/2412.04490},
  urldate = {2026-09-29},
  abstract = {This article investigates the influence of luck and strategic considerations on performance of teams participating in the M6 investment challenge. We find that there is insufficient evidence to suggest that the extreme Sharpe ratios observed are beyond what one would expect by chance, given the number of teams, and thus not necessarily indicative of the possibility of consistently attaining abnormal returns. Furthermore, we introduce a stylized model of the competition to derive and analyze a portfolio strategy optimized for attaining the top rank. The results demonstrate that the task of achieving the top rank is not necessarily identical to that of attaining the best investment returns in expectation. It is possible to improve one's chances of winning, even without the ability to attain abnormal returns, by choosing portfolio weights adversarially based on the current competition ranking. Empirical analysis of submitted portfolio weights aligns with this finding.},
  pubstate = {prepublished},
  keywords = {Quantitative Finance - Portfolio Management},
  file = {/Users/marcgrayson/Zotero/storage/KMG56PFQ/Staněk - 2024 - M6 Investment Challenge The Role of Luck and Strategic Considerations.pdf;/Users/marcgrayson/Zotero/storage/H8RCRJGM/2412.html}
}
